# ✅ SENDGRID EMAIL CONFIGURATION (Keep as backup)
SENDGRID_API_KEY=SG.your_sendgrid_key_here

FROM_EMAIL="Your Healthcare <your_email@gmail.com>"

# ✅ GMAIL SMTP CONFIGURATION
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

EMAIL_PROVIDER=gmail

# Admin Email
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

NODE_ENV=production
USE_ATLAS=true

# ✅ MONGODB CONNECTION
MONGODB_URI=mongodb://127.0.0.1:27017/DoctorOnline
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/DoctorOnline

# ✅ SERVER CONFIG
PORT=5000
FRONTEND_URL=http://localhost:3001

# ✅ CORS
CORS_ORIGIN=http://localhost:3001

# ✅ UPI/QR PAYMENT CONFIGURATION
PLATFORM_COMMISSION_PERCENTAGE=1
DEFAULT_UPI_ID=your_upi_id@bank
QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/

# ✅ COMMISSION SETTINGS
COMMISSION_SETTLEMENT_DAY=1
MIN_COMMISSION_PAYOUT=100

# Cloudinary Configuration (Free Plan)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
USE_CLOUDINARY=true

# Upload Settings
MAX_FILE_SIZE=307200
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

JWT_SECRET=your_jwt_secret_key_here
